{
  "name": "palimpsest-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "test:measurement": "node tests/measurement.check.ts",
    "test:memory": "node tests/memory-events.check.ts",
    "test:performance": "PALIMPSEST_MEASURE_UI=1 playwright test --grep 'measured browser'"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
