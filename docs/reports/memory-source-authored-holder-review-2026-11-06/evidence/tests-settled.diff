+def test_cross_thread_poison_and_original_body_error_survive():
+    fixture = authored()
+    caught = []
+    primary = LookupError('body primary')
+    baseline=live_fds()
+    fds=None
+    with pytest.raises(LookupError) as result:
+        with lease(fixture) as held:
+            fds=retained_fds(held,fixture[0],baseline)
+            def worker():
+                try: held.recheck()
+                except BaseException as error: caught.append(error)
+            thread = threading.Thread(target=worker)
+            thread.start(); thread.join()
+            assert len(caught)==1 and isinstance(caught[0], RuntimeError)
+            with pytest.raises(RuntimeError): held.source_m
+            raise primary
+    require_entered(result,fds)
+    assert result.value is primary
+    assert not owned_fds(fixture[0])
+    closed_fds(fds)
+
