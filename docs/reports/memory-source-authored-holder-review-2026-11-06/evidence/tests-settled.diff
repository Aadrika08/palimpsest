+@pytest.mark.parametrize('primitive,stage', [
+    ('bootstrap','entry'),('bootstrap','body'),('bootstrap','recheck'),('bootstrap','teardown'),
+    ('strong','entry'),('strong','body'),('strong','recheck'),('strong','guard'),
+    ('strong','read'),('strong','teardown')])
+@pytest.mark.parametrize('fault_count',[1,2])
+def test_internal_close_faults_attempt_all_real_fds_and_preserve_primary(monkeypatch,primitive,stage,fault_count):
+    module=api()
+    fixture=authored()
+    root,admission,*_=fixture
+    d=copy.deepcopy(admission)
+    if stage=='entry': d['sha256']='0'*64
+    baseline=live_fds()
+    actual_close=os.close
+    attempted=[]
+    owned=set()
+    primary=LookupError('genuine primitive body primary')
+    entered=False
+    def close_then_fail(fd):
+        owned.update(live_fds()-baseline)
+        attempted.append(fd)
+        actual_close(fd)
+        if len(attempted)<=fault_count:
+            raise OSError(f'injected internal close failure {len(attempted)} after closing FD')
+    expected=ValueError if stage=='entry' else LookupError if stage=='body' else OSError if stage=='teardown' else RuntimeError
+    with monkeypatch.context() as patch:
+        patch.setattr(os,'close',close_then_fail)
+        manager=module.compact.bound_payload(root,d,MIB,time.monotonic()+60) if primitive=='bootstrap' else module.custody.HeldReplayFiles(root,[d],time.monotonic()+60)
+        with pytest.raises(expected) as rejection:
+            with manager as held:
+                entered=True
+                owned.update(live_fds()-baseline)
+                if stage=='body': raise primary
+                if stage in ('recheck','guard','read'):
+                    with (root/admission['path']).open('r+b') as stream: stream.write(b'x')
+                    if primitive=='bootstrap': held[2]()
+                    elif stage=='guard': held.fd_path(admission['path'])
+                    elif stage=='read': held.read(admission['path'],MIB)
+                    else: held.recheck()
+    if stage!='entry' and not entered:
+        raise rejection.value
+    assert entered == (stage!='entry')
+    assert owned and set(attempted)==owned
+    assert len(attempted)==len(owned)  # Each close is attempted once; no blind retry.
+    closed_fds(owned)
+    if stage=='body': assert rejection.value is primary
+    notes=getattr(rejection.value,'__notes__',[])
+    assert len(notes)>=fault_count-(1 if stage=='teardown' else 0)
+    assert not owned_fds(root)
