+@pytest.mark.parametrize('with_body',[False,True])
+def test_multiple_teardown_faults_drain_every_real_context(monkeypatch,with_body):
+    module=api()
+    original=module.compact.bound_payload
+    original_strong_exit=module.custody.HeldReplayFiles.__exit__
+    def strong_exit(self,*args):
+        try: return original_strong_exit(self,*args)
+        finally: raise ArithmeticError('deterministic strong exit after real FD closure')
+    monkeypatch.setattr(module.custody.HeldReplayFiles,'__exit__',strong_exit)
+    primary=LookupError('original body error')
+    class FailingExit:
+        def __init__(self,manager): self.manager=manager
+        def __enter__(self): return self.manager.__enter__()
+        def __exit__(self,*args):
+            try: return self.manager.__exit__(*args)
+            finally: raise OSError('deterministic exit after real payload closure')
+    monkeypatch.setattr(module.compact,'bound_payload',lambda *a,**k:FailingExit(original(*a,**k)))
+    fixture=authored()
+    baseline=live_fds()
+    fds=None
+    with pytest.raises(LookupError if with_body else RuntimeError) as result:
+        with lease(fixture) as held:
+            fds=retained_fds(held,fixture[0],baseline)
+            if with_body: raise primary
+    require_entered(result,fds)
+    if with_body: assert result.value is primary
+    assert len(result.value.__notes__)>=3
+    assert any('deterministic strong exit' in note for note in result.value.__notes__)
+    assert not owned_fds(fixture[0])
+    closed_fds(fds)
+    with pytest.raises(RuntimeError): held.context
