+@pytest.mark.parametrize('bad', ['events-writer','chunk-sha','npz-trailing','npz-duplicate','json-duplicate',
+    'json-trailing','metadata-aggregate','empty-source','profile-bytes','wrong-npy-header'])
+def test_framing_and_combined_metadata_limits_refuse(bad):
+    def edit(role,v):
+        if bad=='events-writer' and role=='raw_events': return v.replace(b': ',b':',1)
+        if bad=='chunk-sha' and role=='raw_events':
+            events=[json.loads(line) for line in v.splitlines()]
+            events[-1]['sha256']='0'*64
+            return b''.join(audit._writer(e) for e in events)
+        if bad=='npz-trailing' and role=='numeric_extra:0': return v+b'trailing'
+        if bad=='npz-duplicate' and role=='numeric_extra:0':
+            out=io.BytesIO(v)
+            with zipfile.ZipFile(out,'a') as z:
+                with pytest.warns(UserWarning, match='Duplicate name'): z.writestr('latency.npy',b'bad')
+            return out.getvalue()
+        if bad=='json-duplicate' and role=='owner_record':
+            payload=memory.canonical_bytes(v)
+            return b'{"case_id":"duplicate",'+payload[1:]
+        if bad=='json-trailing' and role=='owner_record': return memory.canonical_bytes(v)+b'\n'
+        if bad=='metadata-aggregate' and role=='source_closure':
+            v['requirements'][0]['padding']='x'*(MIB-12000)
+        if bad=='empty-source' and role=='raw_manifest': v['row_count']=0
+        if bad=='profile-bytes' and role=='profile': return v.replace(b'"adopted":false',b'"adopted":true ',1)
+        if bad=='wrong-npy-header' and role=='numeric_extra:0':
+            with np.load(io.BytesIO(v),allow_pickle=False) as archive:
+                arrays={name:archive[name].copy() for name in archive.files}
+            arrays['latency']=arrays['latency'].view('<i8')
+            return compact._npz(arrays)
+    refuses(authored(edit=edit), match='Combined authored metadata' if bad=='metadata-aggregate' else None)
