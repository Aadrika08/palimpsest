+@pytest.mark.parametrize('bad', ['trailing','compressed','duplicate','unknown-meta','duplicate-json','missing-entry',
+    'noncontiguous','unknown-typed','unknown-member','metadata-expansion','typed-nodes','entry-count'])
+def test_snp_preflight_refuses_before_decode(bad):
+    def edit(role,payload):
+        if role!='source_snapshot_bytes': return
+        if bad=='trailing': return payload+b'trailing'
+        source=zipfile.ZipFile(io.BytesIO(payload))
+        out=io.BytesIO()
+        with source, zipfile.ZipFile(out,'w',compression=zipfile.ZIP_DEFLATED if bad=='compressed' else zipfile.ZIP_STORED) as dest:
+            for info in source.infolist():
+                name,value=info.filename,source.read(info)
+                if name=='metadata.json':
+                    meta=json.loads(value)
+                    if bad=='unknown-meta': meta['unknown']=None
+                    elif bad=='unknown-typed': meta['container']['unexpected']=None
+                    elif bad=='metadata-expansion': meta['container']['padding']='x'*(8*MIB)
+                    elif bad=='typed-nodes': meta['container']['items'].append(['padding',{'kind':'list','items':[None]*(512*1024)}])
+                    value=json.dumps(meta,separators=(',',':')).encode()
+                    if bad=='duplicate-json': value=b'{"format":"duplicate",'+value[1:]
+                elif bad=='missing-entry': continue
+                elif bad=='noncontiguous': name='state/9999.bin'
+                dest.writestr(name,value)
+            if bad=='duplicate':
+                with pytest.warns(UserWarning, match='Duplicate name'): dest.writestr('metadata.json',b'{}')
+            if bad=='unknown-member': dest.writestr('../unknown',b'authored')
+            if bad=='entry-count':
+                for i in range(8192): dest.writestr(f'unused/{i}',b'authored')
+        return out.getvalue()
+    refuses(authored(edit=edit))
