+def replace_npz(payload, name):
+    with np.load(io.BytesIO(payload), allow_pickle=False) as archive:
+        arrays={key:archive[key].copy() for key in archive.files}
+    arrays[name].flat[0]+=1
+    return compact._npz(arrays)
