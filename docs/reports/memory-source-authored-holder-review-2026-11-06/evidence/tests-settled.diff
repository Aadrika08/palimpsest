+def descriptor(path, payload):
+    return {'path': path, 'size_bytes': len(payload), 'sha256': hashlib.sha256(payload).hexdigest()}
+
+
+def npz_size(schema, count):
+    # NPY1.0 128-byte header; local ZIP64 header, central header, EOCD.
+    return 22 + sum(128 + count * math.prod(shape) * np.dtype(dtype).itemsize
+        + 30 + 20 + 46 + 2 * len((name + '.npy').encode()) for name, (dtype, shape) in schema.items())
+
+
+def authored(*, edit=None, kind='change', condition='oracle'):
+    """Exclusive retained fixture; edit alters real bytes before downstream Ds."""
+    root = Path(f'/var/tmp/palimpsest-AUTHORED-source-vnext-{os.geteuid()}-{uuid.uuid4()}')
+    root.mkdir()
+    case = world.make_family_case('development', 0, 4, kind)
+    b = 'inputs/cases/' + case['case_id']
+    for path in ('inputs/meta', 'inputs/registrations', 'inputs/controls', b + '/source/snapshots',
+            b + '/raw/chunks', b + '/numeric/base', b + '/numeric/extra',
+            'outputs/condition/work', 'outputs/condition/atomic', 'outputs/condition/quarantine'):
+        (root / path).mkdir(parents=True, exist_ok=True)
+    roster = {}
+    records = {}
+
+    def put(role, path, value, maximum=MIB, middle=None):
+        if middle:
+            value = {'schema': f'memory-source-authored-{middle}-vnext-v1', **value, 'claims': copy.deepcopy(CLAIMS)}
+        if edit:
+            replacement = edit(role, value)
+            if replacement is not None:
+                value = replacement
+        payload = memory.canonical_bytes(value) if type(value) is dict else value
+        with (root / path).open('xb') as stream:
+            stream.write(payload)
+            stream.flush()
+            os.fsync(stream.fileno())
+        d = descriptor(path, payload)
+        roster[role] = {'role': role, 'descriptor': d, 'max_bytes': maximum}
+        records[role] = value
+        return d
+
+    profile = put('profile', 'inputs/meta/profile.json', codec.TERMINAL_PATH.read_bytes())
+    closure = put('source_closure', 'inputs/meta/source-closure.json', {'profile': profile,
+        'requirements': sorted([descriptor(p, (codec.ROOT / p).read_bytes()) for p in REQUIREMENTS], key=lambda d: d['path'])}, middle='software-closure')
+    common = {'profile': profile, 'source_closure': closure}
+    state, n, _, events, projected = _acquire(case)
+    events.append(_event('memory_acquired_boundary', n, boundary_tick=n,
+        acquired_evidence=copy.deepcopy(state['supervisor']['acquired_evidence'])))
+    rows = []
+    for row in projected:
+        _, arrays = _policy_row(row, SOURCE)
+        arrays['population_stats'] = np.zeros((3, 4), dtype='<f8')
+        for name in ('reward', 'simulation_time', 'revision', 'latency', 'step_latency'):
+            arrays[name] = arrays[name][()]
+        rows.append({'episode': 0, 'tick': row['tick'], **arrays})
+    raw_schema = {'episode': ('<i8', ()), 'tick': ('<i8', ()), **codec.RAW_ARRAYS}
+    raw_chunks = []
+    for i in range((n + 31) // 32):
+        start, count = 32 * i, min(32, n - 32 * i)
+        arrays = {name: np.stack([row[name] for row in rows[start:start+count]]) for name in raw_schema}
+        payload = compact._npz(arrays)
+        d = put(f'raw_chunk:{i}', f'{b}/raw/chunks/{i:06d}.npz', payload, npz_size(raw_schema, count))
+        raw_chunks.append({'index': i, 'start': start, 'count': count, 'descriptor': d})
+        events.append(_event('chunk', n, episode=0, start=start, count=count,
+            path=f'chunks/{i:06d}.npz', sha256=d['sha256']))
+    _bind_events(events, SOURCE)
+    events_payload = b''.join(audit._writer(e) for e in events)
+    events_d = put('raw_events', b + '/raw/events.jsonl', events_payload, 7*MIB)
+    manifest = put('raw_manifest', b + '/raw/manifest.json', {'case_id': case['case_id'],
+        'source_run_id': SOURCE, 'row_count': n, 'event_count': len(events), 'chunks': raw_chunks}, middle='raw-manifest')
+    sw = world.initial_state(case)
+    sw['last_tick'] = n - 1
+    application = _application(case, state, n, sw, SOURCE)
+    application['event_prefix'] = {'sha256': hashlib.sha256(events_payload).hexdigest(),
+        'size_bytes': len(events_payload), 'event_count': len(events)}
+    snapshot = {'schema': 'memory-source-authored-snapshot-vnext-v1', 'application': application,
+        'native_data': b'opaque AUTHORED bytes; never restore', 'claims': copy.deepcopy(CLAIMS)}
+    snapshot['native_sha256'] = hashlib.sha256(snapshot['native_data']).hexdigest()
+    if edit:
+        replacement = edit('snapshot', snapshot)
+        if replacement is not None:
+            snapshot = replacement
+    snp_path = b + '/source/snapshots/initial.snp'
+    snapshots.save_snapshot(snapshot, root / snp_path)
+    if edit:
+        changed = edit('source_snapshot_bytes', (root / snp_path).read_bytes())
+        if changed is not None:
+            (root / snp_path).write_bytes(changed)
+    snp = descriptor(snp_path, (root / snp_path).read_bytes())
+    roster['source_snapshot'] = {'role': 'source_snapshot', 'descriptor': snp, 'max_bytes': 16*MIB}
+    ident = {'case_id': case['case_id'], 'source_run_id': SOURCE}
+    owner = put('owner_record', b + '/source/owner.json', {**ident, 'snapshot': snp}, middle='owner')
+    report = put('worker_report', b + '/raw/owner-report.json', {**ident, 'snapshot': snp,
+        'total_ticks': n, 'world_state': sw}, middle='owner-report')
+    projected_rows = compact._project_rows(rows, 'source')
+    hashes = {'camera_sequence_sha256': compact._sequence_hash(projected_rows, compact.DIGEST_FIELDS[:-1]),
+        'row_sequence_sha256': compact._sequence_hash(projected_rows, ('row_digest',)),
+        'trace_digest': compact._trace_digest(projected_rows)}
+    raw_audit = put('source_raw_audit', 'inputs/controls/raw-audit.json', {**common, **ident,
+        'case_sha256': memory.sha256(case), 'owner_record': owner, 'worker_report': report,
+        'raw_manifest': manifest, 'raw_events': events_d, 'snapshot': snp,
+        'row_count': n, 'chunk_count': len(raw_chunks), 'event_count': len(events),
+        'recording_bytes': sum(d['size_bytes'] for d in (manifest, events_d, report,
+            *(c['descriptor'] for c in raw_chunks))), **hashes}, middle='raw-audit')
+    producer = put('producer_registration', 'inputs/registrations/producer.json', {**common,
+        'case': case, 'source_run_id': SOURCE, 'owner_record': owner, 'worker_report': report,
+        'raw_manifest': manifest, 'raw_events': events_d, 'raw_audit': raw_audit, 'snapshot': snp}, middle='producer-registration')
+    chunks = []
+    for i, raw_chunk in enumerate(raw_chunks):
+        start, count = raw_chunk['start'], raw_chunk['count']
+        base = compact._npz({name: np.stack([r[name] for r in projected_rows[start:start+count]]) for name in codec.BASE_ARRAYS})
+        extra = compact._npz({name: np.stack([r[name] for r in rows[start:start+count]]) for name in numeric.NUMERIC_FIELDS})
+        bd = put(f'numeric_base:{i}', f'{b}/numeric/base/{i:06d}.npz', base, npz_size(codec.BASE_ARRAYS, count))
+        ed = put(f'numeric_extra:{i}', f'{b}/numeric/extra/{i:06d}.npz', extra, npz_size(numeric.NUMERIC_FIELDS, count))
+        chunks.append({'index': i, 'start': start, 'count': count, 'raw': raw_chunk['descriptor'], 'base': bd, 'extra': ed})
+    ticks = compact.audit_ticks(range(n), event_tick=None, decision_tick=None)
+    frames = compact._npz({'tick': np.array(ticks, dtype='<i8'),
+        **{name: np.stack([rows[t][name] for t in ticks]) for name in ('raw_cam_left', 'raw_cam_right')}})
+    frame_d = put('audit_frames', b + '/numeric/audit-frames.npz', frames, npz_size(compact.FRAME_FIELDS, len(ticks)))
+    index = put('numeric_index', b + '/numeric/index.json', {**ident, 'row_count': n, 'chunks': chunks}, middle='numeric-index')
+    inventory = sorted([index, frame_d, *(x[k] for x in chunks for k in ('base', 'extra'))], key=lambda d:d['path'])
+    conversion = put('source_numeric_conversion', b + '/numeric/conversion.json', {**common, **ident,
+        'producer_registration': producer, 'raw_audit': raw_audit, 'snapshot': snp, 'index': index,
+        'audit_frames': frame_d, 'inventory': inventory, 'row_count': n, 'trace_digest': hashes['trace_digest']}, 65536, 'numeric-conversion')
+    commit = put('source_numeric_commit', b + '/numeric/commit.json', {**common, **ident,
+        'conversion': conversion, 'status': 'AUTHORED-RETENTION-ONLY'}, 16384, 'retention-commit')
+    schedule = {'boundary_tick': n, 'event_tick': None if kind=='no-event' else n + world.registered_profile(case['profile_sha256'])['arm_schedule']['event_offset'],
+        'decision_tick': n + world.registered_profile(case['profile_sha256'])['arm_schedule']['decision_offset']}
+    pending = {'profile': profile, 'source_application_sha256': memory.sha256(application),
+        'case_sha256': memory.sha256(case), 'run_id': RUN}
+    resource = [] if condition == 'oracle' else None
+    selector = {'version': 1, 'condition': condition, 'limit': 1, 'resource': resource,
+        'resource_sha256': memory.sha256(resource), 'provenance_sha256': transition.pending_provenance_vnext(pending) if condition=='oracle' else 'b'*64}
+    resources = {'selector': selector, 'u': memory.artifact()}
+    st = root.stat()
+    admission_value = {**common, **ident, 'case_sha256': memory.sha256(case), 'producer_registration': producer,
+        'source_commit': commit, 'source_raw_audit': raw_audit, 'source_snapshot': snp,
+        'source_numeric_conversion': conversion, 'source_numeric_commit': commit,
+        'condition_slot': {'run_id': RUN, 'condition': condition, 'resources': resources,
+            'condition_resources_sha256': memory.sha256(resources), 'schedule': schedule},
+        'namespace': {'schema':'memory-source-authored-namespace-vnext-v1', 'root': str(root),
+            'uid': os.geteuid(), 'device':st.st_dev, 'inode':st.st_ino},
+        'inventory': sorted(roster.values(), key=lambda d:d['descriptor']['path'])}
+    adm = put('admission', 'inputs/registrations/admission.json', admission_value, middle='admission')
+    return root, adm, case, application, rows, records
