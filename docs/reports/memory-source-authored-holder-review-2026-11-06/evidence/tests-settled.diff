+def lease(fixture, **kwargs):
+    root, adm, case, *_ = fixture
+    module=api()
+    manager=module._open_authored_source_vnext(str(root), adm, case_id=case['case_id'],
+        deadline=kwargs.pop('deadline', time.monotonic()+60), **kwargs)
+    @contextmanager
+    def checked():
+        try:
+            with manager as held: yield held
+        except RuntimeError as error:
+            # Read-only diagnostics from the unchanged primitive's actual saved
+            # witnesses, even if a factory failed before yielding its holder.
+            seen=set()
+            failure=error
+            while failure is not None and id(failure) not in seen:
+                seen.add(id(failure))
+                tb=failure.__traceback__
+                while tb is not None:
+                    if tb.tb_frame.f_code.co_name=='_check_dirs':
+                        files=tb.tb_frame.f_locals['self']
+                        for key,(_,_,_,expected) in files._dirs.items():
+                            path='/'+'/'.join(key)
+                            try: current=module.custody._identity(os.stat(path,follow_symlinks=False))
+                            except OSError as missing: current=repr(missing)
+                            if current!=expected:
+                                error.add_note(f'Actual held directory {path}: expected={expected!r}; current={current!r}')
+                    tb=tb.tb_next
+                failure=failure.__cause__ or failure.__context__
+            raise
+    return checked()
+
+
+def owned_fds(root):
+    result = []
+    for p in Path('/proc/self/fd').iterdir():
+        try:
+            if os.readlink(p).startswith(str(root)):
+                result.append(int(p.name))
+        except FileNotFoundError:
+            pass
+    return result
+
+
+def live_fds():
+    """Exclude the transient directory-listing FD using a real fstat."""
+    result=set()
+    for path in Path('/proc/self/fd').iterdir():
+        try: os.fstat(int(path.name))
+        except OSError: continue
+        result.add(int(path.name))
+    return result
+
+
+def retained_fds(held,root,baseline):
+    active=live_fds()
+    strong=set(held._files._fds)
+    assert strong <= active
+    assert strong.isdisjoint(baseline)
+    return (active-baseline) | strong | set(owned_fds(root))
+
+
+def closed_fds(fds):
+    for fd in fds:
+        with pytest.raises(OSError): os.fstat(fd)
+
+
+def require_entered(rejection,fds):
+    # A setup refusal is never evidence of a post-yield mutation/lifetime gate.
+    if fds is None:
+        raise rejection.value
+
