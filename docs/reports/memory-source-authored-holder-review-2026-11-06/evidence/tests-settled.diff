+@pytest.mark.parametrize('kind,condition', [('change','oracle'),('null','no-U'),('no-event','oracle')])
+def test_real_authored_lease_derives_detached_context_and_closes_fds(kind, condition):
+    fixture = authored(kind=kind, condition=condition)
+    root, adm, case, app, rows, _ = fixture
+    baseline=live_fds()
+    with lease(fixture) as held:
+        assert type(held) is api().HeldSourceVnext
+        assert held.context['source_registration'] == adm
+        assert held.context['source_m_sha256'] == memory.sha256(app['memory']['m'])
+        assert held.context['source_invariant_sha256'] == transition.terminal_condition_invariant_vnext(app)
+        assert held.case == case and held.source_application == app
+        assert len(held._source_rows) == len(rows) > 0
+        assert held.source_snapshot_reference['source_receipt_sha256'] is None
+        assert held.source_snapshot_reference['path'].endswith('/source/snapshots/initial.snp')
+        copy_context, copy_rows = held.context, held._source_rows
+        copy_context['run_id'] = SOURCE
+        copy_rows[0]['cam_left'][:] = 255
+        assert held.context['run_id'] == RUN
+        assert np.array_equal(held._source_rows[0]['cam_left'], rows[0]['cam_left'])
+        fds = retained_fds(held,root,baseline)
+        assert len(fds) >= 17
+        held.recheck()
+        (root/'outputs/condition/work/result.json').write_text('{}')
+        held.recheck()
+    assert not owned_fds(root)
+    closed_fds(fds)
+    with pytest.raises(RuntimeError): held.context
