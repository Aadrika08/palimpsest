            'sys.meta_path[0].owner._phase("authored.no_retry")\nos.write = original_write\n')
        if fail_import:
            code += 'raise RuntimeError("AUTHORED_PRIMARY_FAILURE")\n'
        result = run_cpu(code=code)
        assert 'TRACE_WRITE_RETRIED' not in result.stderr
