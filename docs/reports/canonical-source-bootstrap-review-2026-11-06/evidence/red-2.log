        ({'device': 'gpu'}, 'unknown controller'),
        ({'restore_snapshot': {}}, 'fresh'),
        ({'replace_controller': True}, 'fresh'),
        ({'replace_controller': 0}, 'fresh'),
        ({'replace_controller': None}, 'fresh'),
