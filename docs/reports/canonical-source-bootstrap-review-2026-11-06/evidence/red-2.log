    @pytest.mark.parametrize('changes,reason', [
        ({'scenario': 'reproduction'}, 'canonical prepared'),
        ({'texture': 'realistic'}, 'canonical prepared'),
        ({'controller': 'manual'}, 'canonical prepared'),
